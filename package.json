{
  "name": "polytour",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "vite",
    "pretypecheck": "pnpm cf-typegen",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:version": "node --test tools/release/*.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim": "tsx tools/sim/run.ts",
    "verify:dice": "tsx tools/randomness/verify.ts",
    "check:drand": "tsx tools/randomness/live-check.ts",
    "check:bundle": "node tools/ci/check-bundle-size.ts",
    "check:wrangler": "node tools/ci/check-wrangler-config.ts",
    "check:version": "node tools/release/check-version.ts",
    "version:bump": "node tools/release/bump-version.ts",
    "version:prepare": "node tools/release/prepare-version.ts",
    "build": "pnpm typecheck && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "drand-client": "^1.4.2",
    "gsap": "^3.15.0",
    "hono": "^4.13.11",
    "motion": "^13.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.62.1",
    "@cloudflare/vitest-plugin": "^1.3.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.143.1"
  }
}
